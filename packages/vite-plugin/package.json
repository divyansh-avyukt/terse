{
  "name": "@terseui/vite-plugin",
  "version": "0.1.0",
  "description": "Vite plugin that compiles .terse files to React, with HMR, source maps and the error overlay.",
  "license": "MIT",
  "author": "AVYUKT TECH LABS",
  "homepage": "https://terse-ui.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AVYUKT-TECH-LABS/terse.git",
    "directory": "packages/vite-plugin"
  },
  "bugs": "https://github.com/AVYUKT-TECH-LABS/terse/issues",
  "keywords": [
    "terse",
    "ui",
    "llm",
    "agents",
    "react",
    "shadcn",
    "tailwind",
    "vite",
    "compiler"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "client.d.ts"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@terseui/compiler": "workspace:*",
    "@terseui/core": "workspace:*"
  },
  "peerDependencies": {
    "vite": ">=8"
  },
  "devDependencies": {
    "vite": "^8.3.4"
  }
}
