"import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table"
import { Button } from "@/components/ui/button"
import { ArrowDownIcon, ArrowUpDownIcon, ArrowUpIcon } from "lucide-react"

export interface ThProps {
  sort?: any
  onSort?: any
}

export default function Th({ sort, onSort }: ThProps) {
  return (
    <Table>
      <TableHeader>
        <TableRow>
          <TableHead className="text-right" aria-sort={(({"asc":"ascending","desc":"descending"} as Record<string, string>)[sort] ?? "none")}>
            <Button variant="ghost" size="sm" className="-mx-3 h-8" onClick={onSort}>
              Amount
              {sort === "asc" ? (
                <ArrowUpIcon size={16} className="text-muted-foreground" />
              ) : (
                <>
                  {sort === "desc" ? (
                    <ArrowDownIcon size={16} className="text-muted-foreground" />
                  ) : (
                    <ArrowUpDownIcon size={16} className="text-muted-foreground" />
                  )}
                </>
              )}
            </Button>
          </TableHead>
        </TableRow>
      </TableHeader>
      <TableBody />
    </Table>
  )
}
"
`;

exports[`compiler snapshots > thead 1`] = `
"import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table"
import { Button } from "@/components/ui/button"
import { ArrowDownIcon, ArrowUpDownIcon, ArrowUpIcon } from "lucide-react"

export interface TheadProps {
  rows?: any
  sort?: any
  onSortAmount?: any
}

export default function Thead({ rows, sort, onSortAmount }: TheadProps) {
  return (
    <Table>
      <TableHeader>
        <TableRow>
          <TableHead>ID</TableHead>
          <TableHead className="text-right" aria-sort={(({"asc":"ascending","desc":"descending"} as Record<string, string>)[sort?.amount] ?? "none")}>
            <Button variant="ghost" size="sm" className="-mx-3 h-8" onClick={onSortAmount}>
              Amount
              {sort?.amount === "asc" ? (
                <ArrowUpIcon size={16} className="text-muted-foreground" />
              ) : (
                <>
                  {sort?.amount === "desc" ? (
                    <ArrowDownIcon size={16} className="text-muted-foreground" />
                  ) : (
                    <ArrowUpDownIcon size={16} className="text-muted-foreground" />
                  )}
                </>
              )}
            </Button>
          </TableHead>
        </TableRow>
      </TableHeader>
      <TableBody>
        {rows?.map((r: any, i: number) => (
          <TableRow key={i} className="cursor-pointer" role="button" tabIndex={0} onClick={r?.onOpen} onKeyDown={(e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); r?.onOpen?.(e) } }}>
            <TableCell>{r?.id}</TableCell>
            <TableCell className="text-right">{r?.amount}</TableCell>
          </TableRow>
        ))}
      </TableBody>
    </Table>
  )
}
"
`;

