"import { Textarea } from "@/components/ui/textarea"
import { Label } from "@/components/ui/label"

export interface TextareaViewProps {
  note?: any
  onNote?: any
  err?: any
}

export default function TextareaView({ note, onNote, err }: TextareaViewProps) {
  return (
    <div className="grid gap-2">
      <Label htmlFor="note">Note</Label>
      <Textarea id="note" placeholder="Add a note" rows={3} value={note} onChange={(e) => onNote?.(e.target.value)} aria-invalid={!!err} />
      {err ? (
        <p className="text-destructive text-sm">{err}</p>
      ) : null}
    </div>
  )
}
"
