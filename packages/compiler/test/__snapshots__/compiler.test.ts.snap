}

export default function Stat({ stats }: StatProps) {
  return (
    <Card className="flex-1">
      <CardHeader>
        <CardDescription>Revenue</CardDescription>
        <CardTitle className="text-3xl font-semibold tabular-nums">{stats?.revenue}</CardTitle>
      </CardHeader>
      <CardContent>
        <p className="text-xs text-muted-foreground">{stats?.delta}</p>
      </CardContent>
    </Card>
  )
}
"
`;

exports[`compiler snapshots > table 1`] = `
"import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table"

export interface TableViewProps {
  orders?: any
}

export default function TableView({ orders }: TableViewProps) {
  return (
    <Table>
      <TableHeader>
        <TableRow>
          <TableHead>ID</TableHead>
          <TableHead>Customer</TableHead>
          <TableHead>Date</TableHead>
        </TableRow>
      </TableHeader>
      <TableBody>
        {orders?.map((row: any, i: number) => (
          <TableRow key={i}>
            <TableCell>{row?.id}</TableCell>
            <TableCell>{row?.customer}</TableCell>
            <TableCell>{row?.createdAt}</TableCell>
          </TableRow>
        ))}
      </TableBody>
    </Table>
  )
}
"
`;

