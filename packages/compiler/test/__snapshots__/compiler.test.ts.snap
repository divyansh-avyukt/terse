exports[`compiler snapshots > spec example: user components, each, if/else 1`] = `
"import { Badge } from "@/components/ui/badge"
import { Button } from "@/components/ui/button"
import { Fragment } from "react"
import UserAvatar from "@/components/UserAvatar"

export interface DashboardProps {
  user?: any
  orders?: any
  loading?: any
  onRefresh?: any
}

export default function Dashboard({ user, orders, loading, onRefresh }: DashboardProps) {
  return (
    <main className="mx-auto flex w-full max-w-6xl flex-col gap-6 p-6">
      <h1 className="text-3xl font-bold tracking-tight">Dashboard</h1>
      {loading ? (
        <p className="text-sm">Loading…</p>
      ) : (
        <>
          {orders?.map((order: any, i: number) => (
            <Fragment key={i}>
              <p className="text-sm">{order?.customer}</p>
              <Badge variant="secondary">{order?.status}</Badge>
            </Fragment>
          ))}
        </>
      )}
      {!orders ? (
        <p className="text-sm">No orders</p>
      ) : null}
      <div className="flex flex-row gap-4 items-center justify-between">
        <UserAvatar user={user} size="sm" />
        <Button className="w-fit" variant="outline" onClick={onRefresh}>Refresh</Button>
      </div>
    </main>
  )
}
"
`;

exports[`compiler snapshots > stat 1`] = `
"import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card"

export interface StatProps {
