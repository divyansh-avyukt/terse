      <BarChart data={[{ x: "Thu", s1: 72, s2: 55 }, { x: "Fri", s1: 68, s2: 52 }, { x: "Sat", s1: 65, s2: 50 }]} margin={{ left: 8, bottom: 20 }}>
        <CartesianGrid vertical={false} />
        <XAxis dataKey="x" tickLine={false} axisLine={false} tickMargin={8} minTickGap={24} label={{ value: "Day", position: "insideBottom", offset: -14, className: "fill-muted-foreground" }} />
        <YAxis tickLine={false} axisLine={false} label={{ value: "°F", angle: -90, position: "insideLeft", className: "fill-muted-foreground" }} />
        <ChartTooltip content={<ChartTooltipContent />} />
        <ChartLegend verticalAlign="top" content={<ChartLegendContent verticalAlign="top" />} />
        <Bar dataKey="s1" fill="var(--color-s1)" radius={4} />
        <Bar dataKey="s2" fill="var(--color-s2)" radius={4} />
      </BarChart>
    </ChartContainer>
  )
}
"
`;

