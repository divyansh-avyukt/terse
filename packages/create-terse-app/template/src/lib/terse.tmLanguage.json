{
  "scopeName": "source.terse",
  "name": "Terse",
  "patterns": [
    { "include": "#comment" },
    {
      "match": "^(use)\\s+([A-Z][\\w-]*)\\s+(from)\\b",
      "captures": { "1": { "name": "keyword.control.import.terse" }, "2": { "name": "entity.name.type.terse" }, "3": { "name": "keyword.control.import.terse" } }
    },
    {
      "begin": "^(props)\\b",
      "beginCaptures": { "1": { "name": "storage.type.terse" } },
      "end": "$",
      "patterns": [{ "include": "#comment" }, { "match": "[A-Za-z_$][\\w$]*", "name": "variable.parameter.terse" }]
    },
    {
      "match": "^\\s*(each)\\b(?:\\s+(@[\\w$]+(?:\\.[\\w$]+)*))?(?:\\s+(as)\\s+([A-Za-z_$][\\w$]*))?",
      "captures": { "1": { "name": "keyword.control.loop.terse" }, "2": { "name": "variable.other.terse" }, "3": { "name": "keyword.control.terse" }, "4": { "name": "variable.parameter.terse" } }
    },
    {
      "match": "^\\s*(if)\\b(?:\\s+(not)\\b)?|^\\s*(else)\\b",
      "captures": { "1": { "name": "keyword.control.conditional.terse" }, "2": { "name": "keyword.operator.logical.terse" }, "3": { "name": "keyword.control.conditional.terse" } }
    },
    { "match": "^\\s*([A-Z][\\w-]*)", "captures": { "1": { "name": "entity.name.type.terse" } } },
    { "match": "^\\s*([a-z][\\w-]*)", "captures": { "1": { "name": "entity.name.tag.terse" } } },
    { "include": "#attr" },
    { "include": "#value" }
  ],
  "repository": {
    "comment": { "match": "(?:^|(?<=\\s))#.*$", "name": "comment.line.number-sign.terse" },
    "attr": {
      "match": "\\b([A-Za-z_][\\w-]*)(=)",
      "captures": { "1": { "name": "entity.other.attribute-name.terse" }, "2": { "name": "punctuation.separator.key-value.terse" } }
    },
    "value": {
      "patterns": [
        { "include": "#comment" },
        { "begin": "\"", "end": "\"", "name": "string.quoted.double.terse", "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.terse" }] },
        { "begin": "'", "end": "'", "name": "string.quoted.single.terse", "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.terse" }] },
        { "match": "@[\\w$]+(?:\\.[\\w$]+)*", "name": "variable.other.terse" },
        { "match": "(?<![\\w-])-?\\d+(?:\\.\\d+)?(?![\\w-])", "name": "constant.numeric.terse" },
        { "match": "\\b(?:true|false)\\b", "name": "constant.language.boolean.terse" }
      ]
    }
  }
}
