{
  "comments": { "lineComment": "#" },
  "autoClosingPairs": [
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string"] }
  ],
  "surroundingPairs": [["\"", "\""], ["'", "'"]],
  "indentationRules": { "increaseIndentPattern": "^\\s*\\S", "decreaseIndentPattern": "^\\s*else\\s*$" },
  "folding": { "offSide": true }
}
