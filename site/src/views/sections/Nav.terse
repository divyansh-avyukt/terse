use Logo from "@/components/Logo"
props sourceLabel, onSource, themeLabel, onTheme, github

band pad=xs
  row justify=between
    row gap=sm
      Logo
      badge "v0" tone=muted
    row gap=xs
      button "Benchmarks" href="#benchmarks" variant=ghost size=sm
      button "Spec" href="/llms.txt" variant=ghost size=sm
      button @sourceLabel variant=ghost size=sm on=@onSource
      button @themeLabel variant=ghost size=sm on=@onTheme
      button "GitHub" href=@github variant=outline size=sm
